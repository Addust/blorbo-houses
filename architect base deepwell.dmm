	gun_firenames = list("single" = "single", "burst" = "burst fire", "fuck you" = "full auto", "other" = "misc. fire", "other2" = "very misc. fire", "underbarrel" = "underbarrel weapon")
	},
/obj/item/gun/ballistic/automatic/assault/hydra/no_mag{
	name = "\improper HVR-99 Trioditis Variable Rifle 'ETERNAL DEVOTION'";
	gun_firemodes = list("single","burst","auto");
	desc = "A refitted Scarborough assault rifle, trading modularity and ergonomics for on-the-go firemode switching. Features automatic, three-round burst and single fire modes alongside reinforced components for sustained fire, though mercifully it remains in line with an assault rifle rather than a dedicated LMG. The buttstamp branding has been replaced with the outline of a chibi twintailed woman holding up a double peace sign. A little serial number has been laser-engraved into it - HVR99-01.";
	burst_size = 3;
	burst_delay = 0.5;
	fire_delay = 1.2;
